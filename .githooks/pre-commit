#!/usr/bin/env bash
# .githooks/pre-commit: Verhindert das Committen von Secrets mit Betterleaks

# Prüfen, ob betterleaks installiert ist
if ! command -v betterleaks &> /dev/null; then
    echo "================================================================="
    echo "⚠️  [FEHLER] 'betterleaks' ist auf Ihrem System nicht installiert!"
    echo "Bitte installieren Sie Betterleaks (z. B. via 'brew install betterleaks')."
    echo "Commit abgebrochen."
    echo "================================================================="
    exit 1
fi

echo "🔍 Starte Betterleaks Secret-Scan auf gestagte Änderungen..."

# Scannt nur die gestagten Änderungen (--staged)
betterleaks git . -v --staged --config .betterleaks.toml

EXIT_CODE=$?

if [ $EXIT_CODE -ne 0 ]; then
    echo "================================================================="
    echo "❌ [BLOCKIERT] Betterleaks hat Secrets in den gestagten Dateien gefunden!"
    echo "Bitte entfernen oder maskieren Sie die sensiblen Daten vor dem Commit."
    echo "================================================================="
    exit 1
fi

echo "✅ Betterleaks Scan erfolgreich. Keine Secrets gefunden."
exit 0
